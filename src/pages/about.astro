---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import ApplyCta from '../components/ApplyCta.astro';
import Arcs from '../components/Arcs.astro';
import Media from '../components/Media.astro';
import Star from '../components/Star.astro';
import Badge from '../components/Badge.astro';
import { about as a } from '../data/about';
import { accent } from '../lib/accent';
---
<Base title={a.meta.title} description={a.meta.description}>
  <Header />
  <main id="main">
    <PageHero eyebrow={a.hero.eyebrow} title={a.hero.title} text={a.hero.text}>
      <div class="rise mx-auto mt-10 max-w-5xl md:mt-20" style="--i:3">
        <Media name={a.hero.media} ratio="3 / 2" class="rounded-[2rem]" eager parallax={6} alt={a.hero.alt} />
      </div>
    </PageHero>

    <!-- What "Her" means -->
    <section class="container-page py-16 md:py-36">
      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-20">
        <div>
          <p class="label text-rose-deep" data-reveal>{a.her.eyebrow}</p>
          <h2 class="h2 mt-6" data-split set:html={accent(a.her.title)}></h2>
          <p class="lead mt-6 text-taupe md:mt-8" data-reveal>{a.her.text}</p>
        </div>
        <div class="relative mx-auto flex w-[min(80vw,26rem)] items-center justify-center overflow-hidden rounded-t-full bg-rose-pale pb-12 pt-16 md:pb-16 md:pt-24" data-reveal>
          <Arcs size="md" class="left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 scale-50" />
          <Badge class="relative h-40 w-40 md:h-56 md:w-56" />
        </div>
      </div>
    </section>

    <!-- What "Private Club" means (chapitre encre) -->
    <section class="relative overflow-hidden bg-ink py-16 text-cream md:py-36">
      <Arcs tone="cream" class="left-[85%] top-1/2 -translate-x-1/2 -translate-y-1/2" />
      <div class="container-page relative grid items-center gap-8 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5" data-reveal>
          <Media name={a.club.media} ratio="4 / 5" class="mx-auto w-[min(64vw,24rem)] rounded-t-full" parallax alt={a.club.alt} />
        </div>
        <div class="lg:col-span-7 lg:pl-6">
          <p class="label text-rose" data-reveal>{a.club.eyebrow}</p>
          <h2 class="h2 mt-6" data-split set:html={accent(a.club.title)}></h2>
          <p class="lead mt-6 text-cream/75 md:mt-8" data-reveal>{a.club.text}</p>
          <blockquote class="mt-6 md:mt-8 border-l border-rose/60 pl-6 font-display text-xl italic text-cream/90" data-reveal><p>“{a.club.quote}”</p></blockquote>
          <ul class="mt-10 grid gap-6 border-t border-cream/15 pt-8 sm:grid-cols-3 md:mt-12 md:gap-8" data-reveal-group>
            {a.club.changes.map((c) => (
              <li data-reveal-item>
                <Star class="h-3 w-3 text-rose" />
                <h3 class="mt-4 font-display text-xl md:text-2xl">{c.title}</h3>
                <p class="mt-2 text-cream/70">{c.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- How we work -->
    <section class="container-page py-16 md:py-36">
      <div class="mx-auto max-w-3xl text-center">
        <p class="label text-rose-deep" data-reveal>{a.how.eyebrow}</p>
        <h2 class="h2 mt-6" data-split set:html={accent(a.how.title)}></h2>
      </div>
      <ol class="mx-auto mt-10 grid max-w-5xl gap-x-12 md:mt-16 md:grid-cols-2" data-reveal-group>
        {a.how.principles.map((p, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-b border-rose/50 py-5 md:py-7" data-reveal-item>
            <span class="label-sm pt-2 text-taupe">0{i + 1}</span>
            <div>
              <h3 class="font-display text-xl md:text-2xl">{p.title}</h3>
              <p class="mt-2 text-taupe">{p.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- The team (masqué tant que a.team.enabled est faux) -->
    {a.team.enabled && (
      <section class="container-page pb-16 md:pb-36">
        <div class="mx-auto max-w-3xl text-center">
          <p class="label text-rose-deep" data-reveal>{a.team.eyebrow}</p>
          <h2 class="h2 mt-6" data-split set:html={accent(a.team.title)}></h2>
          <p class="lead mt-6 text-taupe" data-reveal>{a.team.text}</p>
        </div>
        <ul class="mx-auto mt-16 grid max-w-5xl gap-8 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {a.team.members.map((m) => (
            <li class="text-center" data-reveal-item>
              <Media name={m.media} ratio="4 / 5" class="rounded-t-full" alt={m.name} />
              <h3 class="mt-6 font-display text-2xl">{m.name}</h3>
              <p class="label-sm mt-2 text-taupe">{m.role}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <ApplyCta />
  </main>
  <Footer />
</Base>

<script>
  import { initPage } from '../scripts/page';
  initPage();
</script>
