---
/** Footer crème, bandeau slogan rose pâle en écho à la bannière de la marque. */
import Logo from './Logo.astro';
import Star from './Star.astro';
import Link from './Link.astro';
import { footer } from '../data/site';
---
<footer class="border-t border-rose/50">
  <div class="container-page grid gap-14 py-20 lg:grid-cols-12 lg:py-24">
    <div class="lg:col-span-5">
      <Logo class="h-14 md:h-16" />
      <p class="mt-8 max-w-sm text-taupe">{footer.description}</p>
    </div>
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:col-span-7 lg:col-start-6">
      {footer.columns.map((col) => (
        <div>
          <p class="label-sm text-rose-deep">{col.title}</p>
          <ul class="mt-4 space-y-1">
            {col.links.map((l) => (
              <li>
                <Link href={l.href} class="inline-flex min-h-11 items-center font-display text-lg text-ink transition-colors duration-200 hover:text-rose-deep">{l.label}</Link>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <div class="bg-rose-pale" data-tone="rose">
    <div class="container-page flex flex-col gap-4 py-5 md:flex-row md:items-center md:justify-between">
      <p class="label-sm text-ink/70">{footer.bottom.join(' · ')}</p>
      <p class="label flex items-center gap-4 text-ink">
        {footer.slogan.map((s, i) => (<>{i > 0 && <Star class="h-2.5 w-2.5 text-rose-deep" />}<span>{s}</span></>))}
      </p>
    </div>
  </div>
</footer>
