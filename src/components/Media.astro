---
/**
 * Emplacement média. Affiche le fichier dès qu'il existe dans public/medias/,
 * sinon un fond rose pâle à motif ✦ au ratio exact (aucun décalage de mise en page).
 *   images : public/medias/images/<name>.webp (ou .jpg)
 *   vidéos : public/medias/videos/<name>.mp4 (+ .webm) et <name>-poster.webp
 * `parallax` : léger décalage vertical au scroll (desktop, sauf reduced-motion).
 */
import fs from 'node:fs';
import path from 'node:path';
import { withBase } from '../lib/url';

interface Props {
  name: string;
  ratio?: string;
  alt?: string;
  kind?: 'image' | 'video';
  class?: string;
  eager?: boolean;
  showLabel?: boolean;
  parallax?: boolean | number;
}
const { name, ratio = '4 / 5', alt = '', kind = 'image', class: cls = '', eager = false, showLabel = true, parallax = false } = Astro.props;

const root = path.resolve('public/medias');
const exists = (p: string) => fs.existsSync(path.join(root, p));

let img: string | null = null;
if (exists(`images/${name}.webp`)) img = withBase(`/medias/images/${name}.webp`);
else if (exists(`images/${name}.jpg`)) img = withBase(`/medias/images/${name}.jpg`);

const mp4 = exists(`videos/${name}.mp4`) ? withBase(`/medias/videos/${name}.mp4`) : null;
const webm = exists(`videos/${name}.webm`) ? withBase(`/medias/videos/${name}.webm`) : null;
const poster = exists(`videos/${name}-poster.webp`) ? withBase(`/medias/videos/${name}-poster.webp`) : null;
const hasVideo = kind === 'video' && mp4;
const hasImage = kind === 'image' && img;
const placeholder = !hasVideo && !hasImage && !poster;
const innerClass = 'absolute inset-0 h-full w-full object-cover';
const px = parallax === true ? 10 : parallax || 0;
---
<div class:list={['relative overflow-hidden bg-rose-pale', cls]} style={`aspect-ratio:${ratio}`} data-media={name} data-media-kind={kind} data-parallax={px ? px : undefined}>
  {hasImage && (
    <img src={img!} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" class={innerClass} data-parallax-inner />
  )}
  {hasVideo && (
    <video class={innerClass} autoplay muted loop playsinline preload="none" poster={poster ?? undefined} data-lazy-video data-parallax-inner>
      {webm && <source data-src={webm} type="video/webm" />}
      <source data-src={mp4!} type="video/mp4" />
    </video>
  )}
  {!hasVideo && kind === 'video' && poster && (
    <img src={poster} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" class={innerClass} data-parallax-inner />
  )}
  {placeholder && (
    <div class="star-pattern absolute inset-0" data-parallax-inner aria-hidden="true"></div>
  )}
  {hasVideo && (
    <button type="button" class="media-pause" data-media-pause aria-label="Pause video" aria-pressed="false">
      <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" data-icon-pause><path d="M7 5h4v14H7zm6 0h4v14h-4z" fill="currentColor"></path></svg>
      <svg class="ml-0.5 hidden h-4 w-4" viewBox="0 0 24 24" aria-hidden="true" data-icon-play><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    </button>
  )}
  {placeholder && showLabel && (
    <span class="label-sm absolute inset-x-0 bottom-4 text-center text-ink/70 select-none" aria-hidden="true">{name}</span>
  )}
</div>
