---
/** Header : menu flottant en pilule, détaché du bord. Bouton Apply toujours visible. */
import Logo from './Logo.astro';
import Star from './Star.astro';
import { nav } from '../data/site';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href !== '/' && current.startsWith(href);
---
<header data-header class="fixed inset-x-0 top-0 z-40 px-4 pt-4 md:px-6 md:pt-5">
  <div class="header-pill mx-auto flex max-w-6xl items-center justify-between gap-3 rounded-pill bg-cream/80 py-2 pl-5 pr-2 shadow-soft ring-1 ring-rose/40 backdrop-blur-md transition-[background-color,box-shadow] duration-300">
    <a href="/" class="shrink-0 transition-opacity duration-200 hover:opacity-80" aria-label="Elevate Her, home"><Logo class="h-7 md:h-8" decorative /></a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {nav.links.map((l) => (
        <a href={l.href} class="label-sm relative inline-flex min-h-11 items-center text-ink transition-colors duration-200 hover:text-rose-deep aria-[current=page]:text-rose-deep" aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href={nav.cta.href} class="btn btn-ink btn-sm hidden sm:inline-flex">{nav.cta.label}</a>
      <a href={nav.cta.href} class="btn btn-ink btn-sm sm:hidden">{nav.cta.short}</a>
      <button type="button" class="flex h-11 w-11 items-center justify-center rounded-full ring-1 ring-rose/50 transition-colors duration-200 hover:bg-white/70 md:hidden" data-menu-toggle aria-expanded="false" aria-controls="menu" aria-label="Open menu">
        <span class="flex flex-col gap-1.5" aria-hidden="true"><span class="block h-px w-5 bg-ink"></span><span class="block h-px w-5 bg-ink"></span></span>
      </button>
    </div>
  </div>
  <div id="menu" data-menu hidden data-tone="rose" class="fixed inset-0 z-50 flex flex-col bg-rose-pale">
    <div class="flex items-center justify-between px-6 pt-6">
      <Logo class="h-8" decorative />
      <button type="button" class="flex h-11 w-11 items-center justify-center rounded-full bg-white/70 ring-1 ring-rose/50" data-menu-close aria-label="Close menu">
        <span class="relative block h-5 w-5" aria-hidden="true"><span class="absolute left-0 top-1/2 h-px w-5 rotate-45 bg-ink"></span><span class="absolute left-0 top-1/2 h-px w-5 -rotate-45 bg-ink"></span></span>
      </button>
    </div>
    <nav class="flex flex-1 flex-col items-center justify-center gap-6 text-center" aria-label="Mobile">
      {nav.links.map((l) => (<a href={l.href} class="font-display text-5xl" data-menu-link aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>))}
      <a href={nav.cta.href} class="btn btn-ink mt-6" data-menu-link>{nav.cta.label}</a>
    </nav>
    <p class="label-sm flex items-center justify-center gap-3 pb-10 text-ink/70"><Star class="h-2.5 w-2.5 text-rose-deep" />By application only<Star class="h-2.5 w-2.5 text-rose-deep" /></p>
  </div>
</header>
<style>
  [data-header][data-scrolled] .header-pill { background-color: color-mix(in oklab, var(--color-cream) 94%, transparent); }
</style>
