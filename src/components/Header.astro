---
/** Header : menu flottant en pilule, détaché du bord. Bouton Apply toujours visible. Sur téléphone, menu en volet latéral animé. */
import Logo from './Logo.astro';
import Star from './Star.astro';
import Link from './Link.astro';
import { nav, instagramUrl } from '../data/site';
import { withBase } from '../lib/url';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href !== '/' && current.startsWith(withBase(href));
---
<header data-header class="fixed inset-x-0 top-0 z-40 px-4 pt-4 md:px-6 md:pt-5">
  <div class="header-pill mx-auto flex max-w-6xl items-center justify-between gap-3 rounded-pill bg-cream/80 py-2 pl-5 pr-2 shadow-soft ring-1 ring-rose/40 backdrop-blur-md transition-[background-color,box-shadow] duration-300">
    <Link href="/" class="shrink-0 transition-opacity duration-200 hover:opacity-80" aria-label="Elevate Her, home"><Logo class="h-7 md:h-8" decorative /></Link>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {nav.links.map((l) => (
        <Link href={l.href} class="label-sm relative inline-flex min-h-11 items-center text-ink transition-colors duration-200 hover:text-rose-deep aria-[current=page]:text-rose-deep" aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</Link>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <Link href={nav.cta.href} class="btn btn-ink btn-sm hidden sm:inline-flex">{nav.cta.label}</Link>
      <Link href={nav.cta.href} class="btn btn-ink btn-sm sm:hidden">{nav.cta.short}</Link>
      <button type="button" class="flex h-11 w-11 items-center justify-center rounded-full ring-1 ring-rose/50 transition-colors duration-200 hover:bg-white/70 md:hidden" data-menu-toggle aria-expanded="false" aria-controls="menu" aria-label="Open menu">
        <span class="flex flex-col gap-1.5" aria-hidden="true"><span class="block h-px w-5 bg-ink"></span><span class="block h-px w-5 bg-ink"></span></span>
      </button>
    </div>
  </div>
  <div id="menu" data-menu hidden class="fixed inset-0 z-50 md:hidden">
    <div class="menu-backdrop absolute inset-0 bg-ink/35" data-menu-close aria-hidden="true"></div>
    <div class="menu-panel absolute inset-y-0 right-0 flex w-[min(86vw,22rem)] flex-col rounded-l-[2rem] bg-rose-pale shadow-soft" data-tone="rose" role="dialog" aria-modal="true" aria-label="Menu">
      <div class="flex items-center justify-between px-6 pt-6">
        <Logo class="h-7" decorative />
        <button type="button" class="flex h-11 w-11 items-center justify-center rounded-full bg-white/70 ring-1 ring-rose/50" data-menu-close aria-label="Close menu">
          <span class="relative block h-5 w-5" aria-hidden="true"><span class="absolute left-0 top-1/2 h-px w-5 rotate-45 bg-ink"></span><span class="absolute left-0 top-1/2 h-px w-5 -rotate-45 bg-ink"></span></span>
        </button>
      </div>
      <nav class="flex flex-1 flex-col justify-center px-8" aria-label="Mobile">
        {nav.links.map((l, i) => (
          <Link href={l.href} class="menu-item flex min-h-14 items-center justify-between border-b border-ink/10 font-display text-3xl" style={`--i:${i}`} data-menu-link aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}<Star class="h-2.5 w-2.5 text-rose-deep" /></Link>
        ))}
        <Link href={nav.cta.href} class="menu-item btn btn-ink mt-8 w-full" style={`--i:${nav.links.length}`} data-menu-link>{nav.cta.label}</Link>
        <Link href={instagramUrl} class="menu-item label-sm mt-6 inline-flex min-h-11 items-center gap-2 self-start text-ink" style={`--i:${nav.links.length + 1}`} data-menu-link>Instagram</Link>
      </nav>
      <p class="label-sm flex items-center gap-3 px-8 pb-10 text-ink/70"><Star class="h-2.5 w-2.5 text-rose-deep" />By application only</p>
    </div>
  </div>
</header>
<style>
  [data-header][data-scrolled] .header-pill { background-color: color-mix(in oklab, var(--color-cream) 94%, transparent); }
</style>
