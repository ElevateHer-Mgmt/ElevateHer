---
/** Parcours 04 : un anneau en trois segments, plusieurs sources de revenus. Aucune proportion chiffrée. */
import Counter from './Counter.astro';
import { visuals } from '../../data/visuals';
const v = visuals.revenue;
const segments = [
  { offset: 25, c: 'stroke-rose', dot: 'bg-rose' },
  { offset: -9, c: 'stroke-rose-deep', dot: 'bg-rose-deep' },
  { offset: -43, c: 'stroke-ink', dot: 'bg-ink' },
];
---
<div class="absolute inset-x-0 bottom-0 top-[26cqw] flex flex-col items-center px-[10cqw] pb-[9cqw] text-center" data-visual="revenue">
  <svg class="block w-[54cqw]" viewBox="0 0 100 100" fill="none" aria-hidden="true">
    <circle cx="50" cy="50" r="38" class="stroke-ink/10" stroke-width="10" />
    {segments.map((s) => (
      <circle cx="50" cy="50" r="38" pathLength="100" stroke-dasharray="31.3 100" stroke-dashoffset={s.offset} class={s.c} stroke-width="10" data-v="pop" />
    ))}
    <path d="M50 38c0 7 5 12 12 12-7 0-12 5-12 12 0-7-5-12-12-12 7 0 12-5 12-12Z" class="fill-rose-deep" data-v="pop" />
  </svg>
  <div class="mt-auto w-full">
    <p class="font-label text-[max(0.625rem,3.4cqw)] uppercase tracking-[0.22em] text-rose-deep" data-v="fade">{v.label}</p>
    <Counter stat={v.stat} class="mt-[2cqw] justify-center text-[9cqw]" />
    <ul class="mt-[2.5cqw] flex justify-center gap-[4cqw]">
      {v.streams.map((s, i) => (
        <li class="flex items-center gap-[1.6cqw] font-label text-[max(0.625rem,3cqw)] uppercase tracking-[0.18em] text-ink" data-v="fade"><span class:list={['block h-[2.4cqw] w-[2.4cqw] rounded-full', segments[i].dot]}></span>{s}</li>
      ))}
    </ul>
    <p class="mt-[3cqw] font-display text-[max(0.875rem,5cqw)] italic text-ink/80" data-v="fade">{v.caption}</p>
  </div>
</div>
